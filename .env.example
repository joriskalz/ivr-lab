DB_FILE_NAME=.data/app.db

# REQUIRED in production: strong unique value, e.g. `openssl rand -base64 32`.
# The server refuses to start in production without it (or with the old
# well-known placeholder value).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Optional social login providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Comma-separated admin email allowlist. Admin access is granted ONLY to these
# emails; there is no first-user auto-promotion, so set this before the first
# sign-in to get an admin account.
# AUTH_ADMIN_EMAILS=admin@example.com

# Existing softphone server settings
SOFTPHONE_ACS_ENDPOINT=
SOFTPHONE_ACS_ACCESS_KEY=
SOFTPHONE_ACCESS_KEY=
# REQUIRED: strong random secret shared only with the external IVR bot,
# e.g. `openssl rand -hex 32`. It is never shown to regular softphone users.
SOFTPHONE_EXTERNAL_WRITE_SECRET=
SOFTPHONE_PROFILES_JSON=[]

# Optional: origins allowed to embed the app in an iframe (CSP frame-ancestors).
# Defaults to 'self'.
# FRAME_ANCESTORS='self' https://copilotstudio.example
